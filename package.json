{
  "name": "site-ahead",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "convex dev --start \"vite --open\"",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && vite build",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run openspec:check",
    "openspec": "openspec",
    "openspec:refresh": "node tools/openspec-skills.mjs --refresh && oxfmt --write .claude/commands/opsx",
    "openspec:check": "node tools/openspec-skills.mjs --check && openspec validate --all --strict --no-interactive",
    "eval:intake": "node tools/eval-intake.ts",
    "eval:audio": "node tools/eval-audio-intake.ts",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}": [
      "oxlint --fix --deny-warnings --no-error-on-unmatched-pattern",
      "oxfmt --write --no-error-on-unmatched-pattern"
    ],
    "*.{css,html,json,jsonc,md,mdx,yaml,yml}": "oxfmt --write --no-error-on-unmatched-pattern"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@base-ui/react": "^1.8.0",
    "@convex-dev/auth": "0.0.95",
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "convex": "^1.44.0",
    "jose": "6.2.12",
    "lucide-react": "^1.45.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "8.3.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^4.0.0",
    "@fission-ai/openspec": "1.13.0",
    "@oxlint/plugins": "1.82.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.67.0",
    "oxlint": "1.82.0",
    "oxlint-plugin-react-doctor": "0.9.14",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.0"
  }
}
